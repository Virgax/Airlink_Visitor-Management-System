# Copy to .env for local development. Real values live only in Railway variables. Never commit them.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/visitas_dev"
APP_URL="http://localhost:3000"
# Production: visitas.airlinkdr.com (redirects any other host there)
CANONICAL_HOST=""

# 32+ random bytes each: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
PASS_SIGNING_KEY=""
DOC_HASH_KEY=""
SESSION_SECRET=""

# Integration secrets
CRON_SECRET=""
SYNC_SECRET=""
PRINT_AGENT_SECRET=""
TEAMS_ACTION_SECRET=""
TEAMS_WEBHOOK_URL=""

# Microsoft Entra ID app registration "Airlink Visitas" (tenant airlinkdr.com)
# Redirect URI: $APP_URL/api/auth/callback/microsoft-entra-id
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""

# Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:it@airlinkdr.com"

# Email (M365 SMTP relay or any SMTP). Used for daily reports and as a fallback when a user has no push subscription.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Airlink Visitas <visitas@airlinkdr.com>"

# Private media bucket (Railway bucket visitas-media, S3 compatible)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="visitas-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
BACKUP_RETENTION_DAYS="30"

SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Break-glass local admin, created by the idempotent seed if missing (password only used on first creation)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Phase 1+
SPN_SQL_URL=""
# Phase 2+
FCM_SERVICE_ACCOUNT_JSON=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
# Phase 3
ANTHROPIC_API_KEY=""
MQTT_URL=""

# Tests
NOTIFY_FAKE="1"
